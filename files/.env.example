# /opt/pve-mcp/.env  (chmod 600, owned by root). Read by compose.yaml via env_file.
# Names checked against ProxmoxMCP-Plus v0.6.3 src/proxmox_mcp/config/loader.py and server.py.
# No quotes, no spaces around "=" or after commas.
# Replace <MCP_HOSTNAME> (two places on the MCP_ALLOWED_HOSTS line) with your public hostname, e.g. pve-mcp.example.com.

# Native MCP transport (STREAMABLE_HTTP is normalized to STREAMABLE by the code)
MCP_TRANSPORT=STREAMABLE_HTTP
# MUST be 0.0.0.0 inside the container, or Docker port publishing cannot reach it.
# Host-side exposure is limited to 127.0.0.1 by compose.yaml ports: "127.0.0.1:8000:8000".
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer key the client sends as "Authorization: Bearer KEY".
# Leave empty here. Fill it in place so it never prints:
#   sed -i "s|^MCP_API_KEY=.*|MCP_API_KEY=$(openssl rand -hex 32)|" /opt/pve-mcp/.env
# Startup fails if it is empty. Never commit a real key.
MCP_API_KEY=
MCP_ALLOW_UNAUTHENTICATED_HTTP=false

# DNS rebinding / Host header protection (MCP SDK TransportSecuritySettings).
# Entries ending in ":*" match any port. 127.0.0.1 and localhost are for the local curl tests.
MCP_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=<MCP_HOSTNAME>,<MCP_HOSTNAME>:*,127.0.0.1:*,localhost:*

# Only these 29 tools are registered. All are in the code's _READ_ONLY_TOOLS set (tool_wrappers.py).
# get_cluster_join_info is left out on purpose. Unknown names make startup fail (by design).
MCP_TOOL_ALLOWLIST=get_cluster_log,get_cluster_status,get_container_config,get_container_ip,get_containers,get_guest_firewall_log,get_job,get_next_vmid,get_node_diagnostics,get_node_firewall_log,get_node_status,get_node_storage,get_node_syslog,get_node_time,get_nodes,get_storage,get_task_log,get_vm_config,get_vm_ip_addresses,get_vms,list_backups,list_bridges,list_isos,list_jobs,list_snapshots,list_targets,list_templates,poll_job,preflight_container_migration

# Trust the Proxmox root CA for verify_ssl=true (requests honors this when verify=True).
# Remove this line if the Proxmox API uses a certificate from a public CA.
REQUESTS_CA_BUNDLE=/app/proxmox-config/pve-root-ca.pem
